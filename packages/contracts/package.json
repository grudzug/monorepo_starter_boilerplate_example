    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "eslint": "^9.39.1",
    "typescript": "^5.9.2",
    "vitest": "^2.1.8",
    "zod": "^4.3.6"
  }
}
